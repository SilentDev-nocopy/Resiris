{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Resiris",
  "scopeName": "source.resiris",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#include" },
    { "include": "#lifecycle" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#function-definition" },
    { "include": "#module-access" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-hash.resiris",
          "match": "##.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.resiris",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.resiris", "match": "\\\\(?:n|t|\\\\|\"|')" }
          ]
        },
        {
          "name": "string.quoted.single.resiris",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.resiris", "match": "\\\\(?:n|t|\\\\|\"|')" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.resiris", "match": "(?<![A-Za-z_])(?:\\d+\\.\\d*|\\.\\d+)(?![A-Za-z_])" },
        { "name": "constant.numeric.integer.resiris", "match": "(?<![A-Za-z_])\\d+(?![A-Za-z_])" }
      ]
    },
    "include": {
      "patterns": [
        {
          "name": "keyword.control.include.resiris",
          "match": "<include>"
        }
      ]
    },
    "lifecycle": {
      "patterns": [
        {
          "name": "entity.name.function.lifecycle.resiris",
          "match": "\\b(?:START|PROCESS)(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.resiris",
          "match": "\\b(?:v|c|fn|if|elif|else|mat|return|pass)\\b"
        },
        {
          "name": "constant.language.boolean.resiris",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "support.function.builtin.resiris",
          "match": "\\b(?:print_cmd|str|type)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.resiris",
          "match": "\\b(?:UnknownObject|int|float|string|bool|ModuleObject|FunctionalObject)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.resiris" }
          }
        }
      ]
    },
    "module-access": {
      "patterns": [
        {
          "name": "variable.other.module.resiris",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*(?:\\.|\\[))"
        },
        {
          "name": "punctuation.accessor.resiris",
          "match": "[.\\[\\]]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.resiris",
          "match": "(?:\\+=|-=|\\*=|/=|==|!=|>=|<=|=|\\+|-|\\*|/|%|>|<)"
        },
        {
          "name": "punctuation.separator.resiris",
          "match": "[:,()]"
        }
      ]
    }
  }
}
