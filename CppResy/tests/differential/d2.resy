fn add(a, b):
	return a + b

fn classify(n):
	if n < 0:
		return "neg"
	elif n == 0:
		return "zero"
	else:
		return "pos"

v x int = add(2, 3)
print_cmd(x)
print_cmd(classify(-1))
print_cmd(classify(0))
print_cmd(classify(5))
v i int = 0
mat i:
	0:
		print_cmd("zero")
	1:
		print_cmd("one")
	else:
		print_cmd("many")
mat x.type():
	int:
		print_cmd("is int")
	float:
		print_cmd("is float")
	else:
		print_cmd("other")
v d FunctionalObject = FunctionalObject.new(value):
	return value * 3
print_cmd(d(4))
