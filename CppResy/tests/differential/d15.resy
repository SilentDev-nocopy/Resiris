<include> RSMath
print_cmd(RSMath.mod(-7, 3))
print_cmd(RSMath.mod(7, -3))
print_cmd(RSMath.mod(7.5, -2.0))
print_cmd(RSMath.floor(-1.5))
print_cmd(RSMath.ceil(-1.5))
print_cmd(RSMath.round(-1.5))
print_cmd(RSMath.round(0.5))
print_cmd(RSMath.round(2.5))
print_cmd(RSMath.round(-0.5))
print_cmd(RSMath.abs(-3.5))
print_cmd(RSMath.min(2.5, 1.5))
print_cmd(RSMath.max(2.5, 1.5))
print_cmd(RSMath.clamp(5, 1, 3))
print_cmd(RSMath.clamp(-5, 1, 3))
print_cmd(RSMath.clamp(2, 1, 3))
