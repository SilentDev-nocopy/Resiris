<include> RSMath
v results float = 0.0
fn acc(value):
	return RSMath.abs(value) + RSMath.floor(1.9) + RSMath.ceil(1.1) + RSMath.round(2.5)
results = acc(3.5)
print_cmd(results)
print_cmd(RSMath.min(3, 1, 2))
print_cmd(RSMath.max(3, 1, 2))
print_cmd(RSMath.clamp(15, 0, 10))
print_cmd(RSMath.factorial(6))
print_cmd(RSMath.ncr(6, 3))
print_cmd(RSMath.npr(6, 3))
print_cmd(RSMath.gcd(48, 18))
print_cmd(RSMath.lcm(4, 6))
print_cmd(RSMath.mod(-7, 3))
print_cmd(RSMath.hypot(5, 12))
print_cmd(RSMath.ln(2.718281828459045))
print_cmd(RSMath.log10(1000))
print_cmd(RSMath.sin(1))
print_cmd(RSMath.cos(1))
print_cmd(RSMath.tan(1))
print_cmd(RSMath.asin(0.5))
print_cmd(RSMath.acos(0.5))
print_cmd(RSMath.atan(1))
print_cmd(RSMath.pythagoras(9, 40))
print_cmd(RSMath.is_nan(1.0))
print_cmd(RSMath.is_inf(1.0))
print_cmd(RSMath.is_finite(1.0))
print_cmd(RSMath[E])
