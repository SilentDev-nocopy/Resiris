## Timers and the PROCESS lifecycle.
##
## Run it and press Ctrl+C - the CLI prints "Resiris program stopped." and
## exits with 0.
##
##   ./build/resiris examples/04_timer_lifecycle.resy
##
## PROCESS runs at 10 frames per second. `t.process()` returns the time still
## remaining until the timer fires, or 0.0 after it has fired or been stopped.
## The timer advances once per PROCESS frame; it does not use wall-clock time.

<include> RSBase

c FPS float = 10.0

v t ModuleObject = RSBase.await()
v remaining float = 0.0
v frames int = 0

fn on_timer():
	print_cmd("timer fired")

START():
	t.set_timer(0.5).on_timeout("on_timer")

PROCESS(FPS):
	remaining = t.process()
	frames = frames + 1
	print_cmd(frames)
	print_cmd(remaining)
